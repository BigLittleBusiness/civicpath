NODE_ENV=development
PORT=3015
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=8h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civicpath_dev
DB_USER=civicpath
DB_PASSWORD=replace_me
DB_SSL=false
PLATFORM_ENCRYPTION_KEY=replace_with_a_long_random_production_secret
ALTCHA_HMAC_SECRET=replace_with_a_distinct_long_random_production_secret
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Production requires this private S3 bucket for support screenshots and documents.
SUPPORT_ATTACHMENT_S3_BUCKET=
# Development only; production uses private S3 and does not accept local attachment storage.
SUPPORT_ATTACHMENT_LOCAL_PATH=/tmp/civicpath-support-attachments
MFA_ISSUER=CivicPath
PRIVILEGED_ACTION_MINUTES=10
DEMO_MODE=true
