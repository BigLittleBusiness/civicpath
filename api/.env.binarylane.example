# /var/www/civicpath/api/.env — Binary Lane production example
# Generate all values marked REPLACE securely; never commit the real production file.
NODE_ENV=production
PORT=3015
FRONTEND_URL=https://app.civicpath.com.au
CORS_ORIGINS=https://app.civicpath.com.au,https://www.civicpath.com.au
COOKIE_DOMAIN=app.civicpath.com.au
JWT_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_UNIQUE_VALUE
JWT_EXPIRES_IN=8h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civicpath_production
DB_USER=civicpath_production
DB_PASSWORD=REPLACE_WITH_A_DATABASE_PASSWORD
DB_SSL=false
PLATFORM_ENCRYPTION_KEY=REPLACE_WITH_A_DISTINCT_32_BYTE_BASE64_OR_HEX_KEY
ALTCHA_HMAC_SECRET=REPLACE_WITH_A_DISTINCT_HIGH_ENTROPY_SECRET
MFA_ISSUER=CivicPath
PRIVILEGED_ACTION_MINUTES=10
DEMO_MODE=false
